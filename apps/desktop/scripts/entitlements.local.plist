<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 uses JIT. No unsigned executable memory exception is needed. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Self-signed certificates have no Apple Team ID. Electron loads its bundled framework
       in helpers and the main process. Library validation requires an Apple Team ID. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
